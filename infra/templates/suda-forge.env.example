# Copy to /etc/suda-forge/suda-forge.env and replace secrets/URLs.
SUDA_HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://suda_forge:change-me@127.0.0.1:5432/suda_forge?sslmode=disable
LXC_BINARY=lxc
CADDY_ADMIN_URL=http://127.0.0.1:2019
SUDA_DEPLOY_STORAGE_ROOT=/var/lib/suda-forge/deployments
SUDA_COOKIE_SECURE=true
# Optional local AI runtimes.
OLLAMA_URL=
VLLM_URL=
LLAMACPP_URL=
